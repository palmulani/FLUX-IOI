@model Brightloop.Models.Invoice
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Invoice @Model.InvoiceNumber - Brightloop Software</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #0f172a;
            padding: 40px;
            background: #fff;
        }
        .invoice-box {
            max-width: 800px;
            margin: auto;
        }
        @@media print {
            body { padding: 0; }
            .no-print { display: none; }
        }
    </style>
</head>
<body>
    <div class="invoice-box">
        <div class="d-flex justify-content-between align-items-center mb-4 no-print">
            <button onclick="window.print()" class="btn btn-primary rounded-pill px-4">Print / Save as PDF</button>
            <button onclick="window.close()" class="btn btn-light border rounded-pill px-4">Close</button>
        </div>

        <div class="d-flex justify-content-between align-items-start border-bottom pb-4 mb-4">
            <div>
                <h2 class="fw-bold text-primary mb-1">Brightloop Software Inc.</h2>
                <div class="text-muted small">Subscription &amp; Enterprise Cloud Solutions</div>
                <div class="text-muted small">San Francisco, CA | billing@brightloop.com</div>
            </div>
            <div class="text-end">
                <h3 class="fw-bold mb-0">INVOICE</h3>
                <div class="fw-bold text-secondary">@Model.InvoiceNumber</div>
                <div class="small text-muted mt-1">Date: @Model.InvoiceDate.ToString("MMM dd, yyyy")</div>
                <div class="small text-danger fw-semibold">Due: @Model.DueDate.ToString("MMM dd, yyyy")</div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-6">
                <div class="text-muted small text-uppercase fw-bold">Billed To</div>
                <div class="fw-bold fs-5">@Model.Customer?.FullName</div>
                <div class="text-muted">@Model.Customer?.CompanyName</div>
                <div class="text-muted small">@Model.Customer?.Address</div>
                <div class="text-muted small">@Model.Customer?.Email</div>
            </div>
            <div class="col-6 text-end">
                <div class="text-muted small text-uppercase fw-bold">Subscription Plan</div>
                <div class="fw-semibold">@Model.Subscription?.Plan?.Name</div>
                <div class="text-muted small">Billing Cycle: @Model.BillingPeriodStart.ToString("MMM dd") - @Model.BillingPeriodEnd.ToString("MMM dd, yyyy")</div>
                <div class="text-muted small">Status: <strong class="@(Model.Status == "Paid" ? "text-success" : "text-warning")">@Model.Status</strong></div>
            </div>
        </div>

        <table class="table table-bordered mb-4">
            <thead class="table-light">
                <tr>
                    <th>Item Description</th>
                    <th class="text-center">Qty</th>
                    <th class="text-end">Unit Price</th>
                    <th class="text-end">Tax</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td><strong>@line.Description</strong></td>
                        <td class="text-center">@line.Quantity</td>
                        <td class="text-end">$@line.UnitPrice.ToString("F2")</td>
                        <td class="text-end">$@line.TaxAmount.ToString("F2")</td>
                        <td class="text-end fw-bold">$@line.LineTotal.ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="row justify-content-end mb-4">
            <div class="col-5">
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Subtotal:</span>
                    <span>$@Model.SubTotal.ToString("F2")</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Taxes:</span>
                    <span>$@Model.TaxTotal.ToString("F2")</span>
                </div>
                @if (Model.DiscountTotal > 0)
                {
                    <div class="d-flex justify-content-between py-1 text-success">
                        <span>Discount:</span>
                        <span>-$@Model.DiscountTotal.ToString("F2")</span>
                    </div>
                }
                <hr>
                <div class="d-flex justify-content-between py-1 fs-5 fw-bold text-primary">
                    <span>Total Due:</span>
                    <span>$@Model.TotalAmount.ToString("F2")</span>
                </div>
                <div class="d-flex justify-content-between py-1 fw-bold text-success">
                    <span>Paid Amount:</span>
                    <span>-$@Model.PaidAmount.ToString("F2")</span>
                </div>
                <div class="d-flex justify-content-between py-1 fw-bold text-danger border-top">
                    <span>Balance Owed:</span>
                    <span>$@((Model.TotalAmount - Model.PaidAmount).ToString("F2"))</span>
                </div>
            </div>
        </div>

        <div class="border-top pt-4 text-center text-muted small">
            Thank you for choosing Brightloop Software! For billing inquiries, email <strong>palmulani1@gmail.com</strong>
        </div>
    </div>
</body>
</html>
