@model Brightloop.Models.Invoice
@{
    ViewData["Title"] = $"Invoice {Model.InvoiceNumber}";
    var balanceDue = Model.TotalAmount - Model.PaidAmount;
    var isOverdue = (Model.Status != "Paid" && Model.Status != "Cancelled" && Model.DueDate < DateTime.UtcNow);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="small text-muted mb-1">
            <a href="@Url.Action("Index", "Invoices")" class="text-decoration-none text-muted">Invoices</a> / @Model.InvoiceNumber
        </div>
        <h4 class="fw-bold mb-0">@Model.InvoiceNumber</h4>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a href="@Url.Action("Print", "Invoices", new { id = Model.Id })" target="_blank" class="btn btn-light border rounded-pill px-3">
            <i class="bi bi-printer me-1"></i> Print / PDF
        </a>

        <form asp-action="SendEmail" asp-route-id="@Model.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary rounded-pill px-3">
                <i class="bi bi-envelope me-1"></i> Send via Email
            </button>
        </form>

        @if (Model.Status == "Draft")
        {
            <form asp-action="Confirm" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary-bright rounded-pill px-3">Confirm Invoice</button>
            </form>
        }

        @if (balanceDue > 0 && Model.Status != "Cancelled")
        {
            <button class="btn btn-success rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#paymentModal">
                <i class="bi bi-credit-card me-1"></i> Record Payment
            </button>
        }

        @if (Model.Status != "Paid" && Model.Status != "Cancelled")
        {
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Cancel this invoice?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger rounded-pill px-3">Cancel</button>
            </form>
        }
    </div>
</div>

@if (isOverdue)
{
    <div class="alert alert-danger rounded-4 d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div><strong>Payment Overdue:</strong> This invoice was due on @Model.DueDate.ToString("MMM dd, yyyy"). Balance remaining: <strong>$@balanceDue.ToString("F2")</strong>.</div>
    </div>
}

<div class="row g-4 mb-4">
    <!-- Invoice Info -->
    <div class="col-lg-8">
        <div class="card-bright p-4 h-100">
            <h6 class="fw-bold mb-3">Customer &amp; Billing Cycle</h6>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="small text-muted">Billed To</div>
                    <div class="fw-bold">@Model.Customer?.FullName</div>
                    <div class="small text-muted">@Model.Customer?.CompanyName</div>
                    <div class="small text-muted">@Model.Customer?.Email | @Model.Customer?.Phone</div>
                </div>
                <div class="col-md-6">
                    <div class="small text-muted">Source Subscription</div>
                    <div class="fw-bold">
                        @if (Model.Subscription != null)
                        {
                            <a href="@Url.Action("Details", "Subscriptions", new { id = Model.SubscriptionId })" class="text-decoration-none" style="color: #4f46e5;">
                                @Model.Subscription.SubscriptionNumber
                            </a>
                            <div class="small text-muted">Plan: @Model.Subscription.Plan?.Name</div>
                        }
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="small text-muted">Invoice Date</div>
                    <div class="fw-semibold">@Model.InvoiceDate.ToString("MMM dd, yyyy")</div>
                </div>
                <div class="col-md-4">
                    <div class="small text-muted">Payment Due Date</div>
                    <div class="fw-semibold @(isOverdue ? "text-danger" : "")">@Model.DueDate.ToString("MMM dd, yyyy")</div>
                </div>
                <div class="col-md-4">
                    <div class="small text-muted">Billing Period</div>
                    <div class="small">@Model.BillingPeriodStart.ToString("MMM dd") - @Model.BillingPeriodEnd.ToString("MMM dd, yyyy")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Settlement Balance -->
    <div class="col-lg-4">
        <div class="card-bright p-4 h-100 bg-light">
            <h6 class="fw-bold mb-3">Payment Summary</h6>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Invoice Total:</span>
                <span class="fw-bold">$@Model.TotalAmount.ToString("F2")</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Total Paid:</span>
                <span class="fw-bold text-success">$@Model.PaidAmount.ToString("F2")</span>
            </div>
            <hr>
            <div class="d-flex justify-content-between mb-2">
                <span class="fw-bold">Balance Owed:</span>
                <span class="fw-bold fs-4 @(balanceDue > 0 ? "text-danger" : "text-success")">$@balanceDue.ToString("F2")</span>
            </div>
            <div>
                <span class="badge @(Model.Status == "Paid" ? "badge-paid" : "badge-confirmed") px-3 py-1 rounded-pill">
                    Status: @Model.Status
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Itemized Lines -->
<div class="card-bright p-4 mb-4">
    <h6 class="fw-bold mb-3">Itemized Invoice Lines</h6>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr class="text-muted small text-uppercase">
                    <th>Description</th>
                    <th>Qty</th>
                    <th>Unit Price</th>
                    <th>Tax Amount</th>
                    <th>Discount</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td class="fw-bold">@line.Description</td>
                        <td>@line.Quantity</td>
                        <td>$@line.UnitPrice.ToString("F2")</td>
                        <td>$@line.TaxAmount.ToString("F2")</td>
                        <td>@if (line.DiscountAmount > 0) { <span class="text-success">-$@line.DiscountAmount.ToString("F2")</span> } else { <span class="text-muted">-</span> }</td>
                        <td class="fw-bold">$@line.LineTotal.ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Payments Recorded Ledger -->
<div class="card-bright p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0">Payments Received Against this Invoice</h6>
        @if (balanceDue > 0 && Model.Status != "Cancelled")
        {
            <button class="btn btn-sm btn-outline-success rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#paymentModal">
                <i class="bi bi-plus-lg me-1"></i> Add Payment
            </button>
        }
    </div>

    @if (Model.Payments.Count == 0)
    {
        <div class="p-3 text-center text-muted small bg-light rounded-3">
            No payments recorded yet for this invoice.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-muted small text-uppercase">
                        <th>Payment #</th>
                        <th>Date</th>
                        <th>Method</th>
                        <th>Reference / Note</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Payments)
                    {
                        <tr>
                            <td class="fw-bold text-dark"><i class="bi bi-check-circle text-success me-1"></i> @p.PaymentNumber</td>
                            <td>@p.PaymentDate.ToString("MMM dd, yyyy")</td>
                            <td><span class="badge bg-light text-dark border px-2 py-1">@p.PaymentMethod</span></td>
                            <td class="text-muted small">@p.ReferenceNote</td>
                            <td class="fw-bold text-success">+$@p.Amount.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Record Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Record Customer Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Payments" asp-action="RecordPayment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="invoiceId" value="@Model.Id" />
                <div class="modal-body">
                    <div class="p-3 bg-light rounded-3 mb-3">
                        <div class="d-flex justify-content-between small">
                            <span class="text-muted">Total Invoice:</span>
                            <span>$@Model.TotalAmount.ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between small fw-bold text-danger">
                            <span>Balance Due:</span>
                            <span>$@balanceDue.ToString("F2")</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Amount to Record ($)</label>
                        <input type="number" step="0.01" name="amount" value="@balanceDue.ToString("F2")" max="@balanceDue" min="0.01" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Payment Method</label>
                        <select name="paymentMethod" class="form-select">
                            <option value="Bank Transfer">Bank Transfer / Wire</option>
                            <option value="Credit Card">Credit Card</option>
                            <option value="UPI">UPI / Instant Digital</option>
                            <option value="Cash">Cash</option>
                            <option value="Cheque">Corporate Cheque</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Payment Date</label>
                        <input type="date" name="paymentDate" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Reference Note (Transaction / Wire ID)</label>
                        <input type="text" name="referenceNote" placeholder="e.g. Wire Ref #8930419" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Save Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>
