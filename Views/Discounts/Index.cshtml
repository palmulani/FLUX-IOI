@model List<Brightloop.Models.DiscountRule>
@{
    ViewData["Title"] = "Discount Rules & Volume Incentives";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Discount Rules &amp; Incentives</h4>
        <p class="text-muted small mb-0">Admin-exclusive rules for percentage/fixed discounts, minimum purchases, and usage limits</p>
    </div>
    <button class="btn btn-primary-bright" data-bs-toggle="modal" data-bs-target="#newDiscountModal">
        <i class="bi bi-plus-circle me-1"></i> New Discount Rule
    </button>
</div>

<div class="card-bright p-4">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr class="text-muted small text-uppercase">
                    <th>Code</th>
                    <th>Type &amp; Value</th>
                    <th>Applies To</th>
                    <th>Conditions</th>
                    <th>Validity Window</th>
                    <th>Usage Limit</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    var isExpired = d.EndDate < DateTime.UtcNow;
                    var isLimitReached = d.TimesUsed >= d.MaxUsageLimit;
                    <tr>
                        <td>
                            <span class="badge bg-light text-dark border px-3 py-2 font-monospace fw-bold fs-6">
                                @d.Code
                            </span>
                        </td>
                        <td class="fw-bold text-success">
                            @(d.DiscountType == "Percentage" ? $"{d.Value}% Off" : $"${d.Value:F2} Fixed Off")
                        </td>
                        <td>
                            @if (d.AppliesTo == "Product")
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Specific Product: @d.SpecificProduct?.Name</span>
                            }
                            else
                            {
                                <span class="badge bg-primary-subtle text-primary">Whole Subscription</span>
                            }
                        </td>
                        <td class="small text-muted">
                            @if (d.MinQuantity.HasValue) { <div>Min Qty: @d.MinQuantity seats</div> }
                            @if (d.MinAmount.HasValue) { <div>Min Spend: $@d.MinAmount.Value.ToString("F2")</div> }
                            @if (!d.MinQuantity.HasValue && !d.MinAmount.HasValue) { <span>None (Unconditional)</span> }
                        </td>
                        <td class="small">
                            <div>@d.StartDate.ToString("MMM dd, yyyy") -</div>
                            <div class="@(isExpired ? "text-danger fw-bold" : "text-muted")">@d.EndDate.ToString("MMM dd, yyyy") @(isExpired ? "(Expired)" : "")</div>
                        </td>
                        <td>
                            <div class="fw-semibold @(isLimitReached ? "text-danger" : "text-dark")">@d.TimesUsed / @d.MaxUsageLimit used</div>
                            <div class="progress" style="height: 4px; width: 80px;">
                                <div class="progress-bar @(isLimitReached ? "bg-danger" : "bg-success")" style="width: @(Math.Min(100, (d.TimesUsed * 100) / Math.Max(1, d.MaxUsageLimit)))%"></div>
                            </div>
                        </td>
                        <td>
                            @if (!d.IsActive || isExpired || isLimitReached)
                            {
                                <span class="badge bg-danger-subtle text-danger px-3 py-1 rounded-pill">Inactive</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill">Active</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="Toggle" asp-route-id="@d.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-light border rounded-pill px-3">
                                    @(d.IsActive ? "Disable" : "Enable")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- New Discount Modal -->
<div class="modal fade" id="newDiscountModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Create Discount Rule (Admin Only)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Promo Code</label>
                            <input type="text" name="Code" class="form-control text-uppercase" placeholder="e.g. MULTISEAT20" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Discount Type</label>
                            <select name="DiscountType" class="form-select">
                                <option value="Percentage">Percentage (%)</option>
                                <option value="Fixed">Fixed Amount ($)</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Value (% or $)</label>
                            <input type="number" step="0.01" name="Value" class="form-control" placeholder="15" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Applies To</label>
                            <select name="AppliesTo" class="form-select">
                                <option value="Subscription">Whole Subscription</option>
                                <option value="Product">Specific Product</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Min Quantity (Seats)</label>
                            <input type="number" name="MinQuantity" class="form-control" placeholder="e.g. 5" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Min Purchase Amount ($)</label>
                            <input type="number" step="0.01" name="MinAmount" class="form-control" placeholder="e.g. 2000.00" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Start Date</label>
                            <input type="date" name="StartDate" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">End Date</label>
                            <input type="date" name="EndDate" value="@DateTime.UtcNow.AddMonths(3).ToString("yyyy-MM-dd")" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Max Times Used Limit</label>
                        <input type="number" name="MaxUsageLimit" value="50" min="1" class="form-control" required />
                        <div class="form-text small">Stops automatically when it expires or runs out.</div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-bright rounded-pill px-4">Save Rule</button>
                </div>
            </form>
        </div>
    </div>
</div>
