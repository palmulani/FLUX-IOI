@model List<Brightloop.Models.User>
@{
    ViewData["Title"] = "Staff Access Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Staff Access Management</h4>
        <p class="text-muted small mb-0">Role-based internal permission control (Admin Exclusive)</p>
    </div>
    <button class="btn btn-primary-bright" data-bs-toggle="modal" data-bs-target="#addStaffModal">
        <i class="bi bi-person-plus-fill me-1"></i> Add Internal Staff
    </button>
</div>

<div class="card-bright p-4">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr class="text-muted small text-uppercase">
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark">
                            <i class="bi bi-person-badge text-primary me-2"></i> @user.FullName
                        </td>
                        <td>@user.Email</td>
                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span class="badge bg-danger-subtle text-danger px-3 py-1 rounded-pill">Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill">Staff (Operations)</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill">Active</span>
                        </td>
                        <td class="text-muted small">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Staff Modal -->
<div class="modal fade" id="addStaffModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Add Internal Staff Member</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddStaff" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Full Name</label>
                        <input type="text" name="fullName" class="form-control" placeholder="e.g. David Miller" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Email Address</label>
                        <input type="email" name="email" class="form-control" placeholder="david@brightloop.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Initial Password (>8 chars, Upper, Lower, Special)</label>
                        <input type="password" name="password" class="form-control" placeholder="StrongPassword@123" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Role</label>
                        <select name="role" class="form-select">
                            <option value="Staff">Staff (Operations &amp; Billing)</option>
                            <option value="Admin">Administrator (Full Access)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-bright rounded-pill px-4">Create Member</button>
                </div>
            </form>
        </div>
    </div>
</div>
