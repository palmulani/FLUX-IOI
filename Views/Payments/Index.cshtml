@model List<Brightloop.Models.Payment>
@{
    ViewData["Title"] = "Customer Payments Ledger";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Customer Payments Ledger</h4>
        <p class="text-muted small mb-0">Auditable record of all settlements across payment methods</p>
    </div>
</div>

<div class="card-bright p-4">
    @if (Model.Count == 0)
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-credit-card fs-1 d-block mb-2"></i>
            No payments recorded yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-muted small text-uppercase">
                        <th>Receipt #</th>
                        <th>Customer</th>
                        <th>Invoice #</th>
                        <th>Payment Date</th>
                        <th>Method</th>
                        <th>Note / Reference</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">
                                <i class="bi bi-check-circle-fill text-success me-1"></i> @p.PaymentNumber
                            </td>
                            <td>
                                <div class="fw-semibold">@p.Customer?.FullName</div>
                                <div class="small text-muted">@p.Customer?.CompanyName</div>
                            </td>
                            <td>
                                @if (p.Invoice != null)
                                {
                                    <a href="@Url.Action("Details", "Invoices", new { id = p.InvoiceId })" class="text-decoration-none fw-semibold" style="color: #4f46e5;">
                                        @p.Invoice.InvoiceNumber
                                    </a>
                                }
                            </td>
                            <td>@p.PaymentDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge bg-light text-dark border px-3 py-1 rounded-pill">
                                    @p.PaymentMethod
                                </span>
                            </td>
                            <td class="small text-muted">@p.ReferenceNote</td>
                            <td class="text-end fw-bold text-success fs-6">
                                +$@p.Amount.ToString("F2")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
