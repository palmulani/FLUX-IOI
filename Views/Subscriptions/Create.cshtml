@{
    ViewData["Title"] = "Create Subscription / Offer";
    var tmpl = ViewBag.SelectedTemplate as Brightloop.Models.QuotationTemplate;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">New Subscription or Quotation</h4>
        <p class="text-muted small mb-0">Create from scratch or load directly from a pre-configured quotation template</p>
    </div>
    <a href="@Url.Action("Index", "Subscriptions")" class="btn btn-light border rounded-pill px-4">
        &larr; Back to List
    </a>
</div>

<!-- Quotation Template Selector Card -->
<div class="card-bright p-3 mb-4 bg-light border-primary-subtle">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-magic fs-4 text-primary"></i>
            <div>
                <div class="fw-bold small text-uppercase">Fast-Track from Quotation Template</div>
                <div class="text-muted small">Auto-fills pre-negotiated plans, variant lines, and discount tiers</div>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span id="templateNotice" class="badge bg-success-subtle text-success px-3 py-2 rounded-pill d-none"></span>
            <select id="templatePicker" class="form-select form-select-sm" onchange="loadTemplate(this.value)">
                <option value="">-- Choose Template to Load --</option>
                @foreach (var t in (List<Brightloop.Models.QuotationTemplate>)ViewBag.Templates)
                {
                    <option value="@t.Id" selected="@(tmpl?.Id == t.Id)">@t.Name (@t.ValidityDays days validity)</option>
                }
            </select>
        </div>
    </div>
</div>

<form asp-action="Create" method="post" id="subForm">
    @Html.AntiForgeryToken()

    <div class="card-bright p-4 mb-4">
        <h6 class="fw-bold mb-3">1. Contract Parties &amp; Terms</h6>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Customer</label>
                <select name="customerId" class="form-select" required>
                    <option value="">-- Select Customer --</option>
                    @foreach (var c in (List<Brightloop.Models.User>)ViewBag.Customers)
                    {
                        <option value="@c.Id">@c.FullName (@(c.CompanyName ?? c.Email))</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Billing Plan</label>
                <select name="planId" id="planSelect" class="form-select" onchange="recalculateEstimate()" required>
                    <option value="">-- Select Plan --</option>
                    @foreach (var p in (List<Brightloop.Models.Plan>)ViewBag.Plans)
                    {
                        <option value="@p.Id" data-minqty="@p.MinQuantity" data-freq="@p.BillingFrequency" selected="@(tmpl?.DefaultPlanId == p.Id)">
                            @p.Name (Min: @p.MinQuantity seats &bull; $@p.BasePrice/@p.BillingFrequency)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Payment Terms</label>
                <select name="paymentTerms" class="form-select">
                    <option value="Immediate">Immediate Payment</option>
                    <option value="15 Days" selected>Net 15 Days</option>
                    <option value="30 Days">Net 30 Days</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Promo / Discount Code</label>
                <input type="text" name="discountCode" class="form-control" placeholder="e.g. ODOO2026" />
            </div>
        </div>
    </div>

    <!-- Product Lines -->
    <div class="card-bright p-4 mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div class="d-flex align-items-center gap-2">
                <h6 class="fw-bold mb-0">2. Product Lines &amp; Variant Surcharges</h6>
                <span id="seatCountBadge" class="badge bg-secondary-subtle text-secondary px-3 py-1 rounded-pill">Total Seats: 0</span>
                <span id="minQtyStatusBadge" class="badge px-3 py-1 rounded-pill"></span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="addLineRow()">
                <i class="bi bi-plus-lg me-1"></i> Add Line Item
            </button>
        </div>

        <div class="table-responsive">
            <table class="table" id="linesTable">
                <thead>
                    <tr class="text-muted small text-uppercase">
                        <th style="width: 35%;">Product</th>
                        <th style="width: 30%;">Variant (e.g. Odoo brand +$560)</th>
                        <th style="width: 15%;">Quantity</th>
                        <th style="width: 15%;">Unit Price ($)</th>
                        <th style="width: 5%;"></th>
                    </tr>
                </thead>
                <tbody id="linesContainer">
                    @if (tmpl != null && tmpl.Lines.Count > 0)
                    {
                        foreach (var l in tmpl.Lines)
                        {
                            <tr class="line-row">
                                <td>
                                    <select name="productIds" class="form-select product-selector" onchange="updateRowPrice(this)" required>
                                        @foreach (var p in (List<Brightloop.Models.Product>)ViewBag.Products)
                                        {
                                            <option value="@p.Id" data-price="@p.SalesPrice" selected="@(p.Id == l.ProductId)">@p.Name ($@p.SalesPrice)</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select name="variantIds" class="form-select variant-selector" onchange="updateRowPrice(this)">
                                        <option value="0" data-extra="0">Standard Edition (+$0)</option>
                                        @if (l.Product?.Variants != null)
                                        {
                                            foreach (var v in l.Product.Variants)
                                            {
                                                <option value="@v.Id" data-extra="@v.PriceExtra" selected="@(v.Id == l.VariantId)">@v.VariantName (+$@v.PriceExtra)</option>
                                            }
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="number" name="quantities" value="@l.Quantity" min="1" class="form-control" />
                                </td>
                                <td>
                                    <input type="number" step="0.01" name="unitPrices" value="@(l.Product?.SalesPrice ?? 0)" class="form-control price-input" />
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-light text-danger" onclick="this.closest('tr').remove()"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="line-row">
                            <td>
                                <select name="productIds" class="form-select product-selector" onchange="updateRowPrice(this)" required>
                                    @foreach (var p in (List<Brightloop.Models.Product>)ViewBag.Products)
                                    {
                                        <option value="@p.Id" data-price="@p.SalesPrice">@p.Name ($@p.SalesPrice)</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <select name="variantIds" class="form-select variant-selector" onchange="updateRowPrice(this)">
                                    <option value="0" data-extra="0">Standard Edition (+$0)</option>
                                    <option value="2" data-extra="560">Brand: Odoo Enterprise (+$560)</option>
                                </select>
                            </td>
                            <td>
                                <input type="number" name="quantities" value="1" min="1" class="form-control" />
                            </td>
                            <td>
                                <input type="number" step="0.01" name="unitPrices" value="1200.00" class="form-control price-input" />
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-light text-danger" onclick="this.closest('tr').remove()"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Live Contract Estimate Calculator -->
    <div class="card-bright p-4 mb-4 bg-light border-0">
        <div class="row align-items-center">
            <div class="col-md-7">
                <div class="small fw-bold text-uppercase text-muted">Contract Real-Time Estimate</div>
                <div id="minQtyWarning" class="small text-danger fw-semibold mt-1 d-none">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> <span id="minQtyWarningText">Plan requires more seats than currently selected.</span>
                </div>
                <div id="minQtySuccess" class="small text-success fw-semibold mt-1">
                    <i class="bi bi-check-circle-fill me-1"></i> Minimum seat constraint satisfied for selected plan.
                </div>
            </div>
            <div class="col-md-5 text-md-end mt-3 mt-md-0">
                <div class="d-flex justify-content-md-end gap-3 text-start text-md-end">
                    <div>
                        <span class="text-muted small">Subtotal:</span>
                        <div class="fw-bold" id="liveSubtotal">$0.00</div>
                    </div>
                    <div>
                        <span class="text-muted small">Tax (18%):</span>
                        <div class="fw-bold" id="liveTax">$0.00</div>
                    </div>
                    <div>
                        <span class="text-muted small">Cycle Total:</span>
                        <div class="fw-bold fs-5 text-primary" id="liveTotal">$0.00</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="d-flex justify-content-end gap-3 mb-5">
        <button type="submit" id="btnDraft" name="initialStatus" value="Draft" class="btn btn-light border rounded-pill px-4">
            Save as Draft
        </button>
        <button type="submit" id="btnQuote" name="initialStatus" value="Quotation" class="btn btn-outline-primary rounded-pill px-4">
            Save as Quotation
        </button>
        <button type="submit" id="btnConfirm" name="initialStatus" value="Confirmed" class="btn btn-primary-bright rounded-pill px-4">
            Confirm &amp; Proceed
        </button>
    </div>
</form>

@section Scripts {
    <script>
        function loadTemplate(templateId) {
            if (!templateId) return;

            const badge = document.getElementById('templateNotice');
            badge.classList.remove('d-none');
            badge.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Loading template blueprint...';

            fetch('@Url.Action("GetTemplateData", "QuotationTemplates")?id=' + templateId)
                .then(r => r.json())
                .then(data => {
                    if (!data.success) return;

                    // Set default plan
                    const planSelect = document.getElementById('planSelect');
                    if (data.defaultPlanId) {
                        planSelect.value = data.defaultPlanId;
                    }

                    // Render lines
                    const container = document.getElementById('linesContainer');
                    container.innerHTML = '';

                    data.lines.forEach(l => {
                        let variantOptions = '<option value="0" data-extra="0">Standard Edition (+$0)</option>';
                        l.variants.forEach(v => {
                            const isSelected = (v.id === l.variantId) ? 'selected' : '';
                            variantOptions += `<option value="${v.id}" data-extra="${v.priceExtra}" ${isSelected}>${v.variantName} (+$${v.priceExtra.toFixed(2)})</option>`;
                        });

                        const rowHtml = `
                            <tr class="line-row">
                                <td>
                                    <select name="productIds" class="form-select product-selector" onchange="updateRowPrice(this)" required>
                                        <option value="${l.productId}" data-price="${l.basePrice}" selected>${l.productName} ($${l.basePrice.toFixed(2)})</option>
                                    </select>
                                </td>
                                <td>
                                    <select name="variantIds" class="form-select variant-selector" onchange="updateRowPrice(this)">
                                        ${variantOptions}
                                    </select>
                                </td>
                                <td>
                                    <input type="number" name="quantities" value="${l.quantity}" min="1" class="form-control" />
                                </td>
                                <td>
                                    <input type="number" step="0.01" name="unitPrices" value="${l.basePrice.toFixed(2)}" class="form-control price-input" />
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-light text-danger" onclick="this.closest('tr').remove(); recalculateEstimate();"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>`;
                        container.innerHTML += rowHtml;
                    });

                    // Trigger row price update & recalculation
                    document.querySelectorAll('#linesContainer .line-row').forEach(r => {
                        updateRowPrice(r.querySelector('.variant-selector'));
                    });

                    badge.innerHTML = `<i class="bi bi-check2-circle me-1"></i> Loaded: <strong>${data.name}</strong> (${data.lines.length} lines, ${data.validityDays}d validity)`;
                })
                .catch(err => {
                    badge.innerHTML = '<span class="text-danger">Failed to load template.</span>';
                });
        }

        function addLineRow() {
            const container = document.getElementById('linesContainer');
            const row = container.querySelector('.line-row');
            if (row) {
                const clone = row.cloneNode(true);
                // reset values in clone
                clone.querySelector('input[name="quantities"]').value = "1";
                container.appendChild(clone);
                recalculateEstimate();
            }
        }

        function updateRowPrice(element) {
            const row = element.closest('tr');
            const prodSelect = row.querySelector('.product-selector');
            const varSelect = row.querySelector('.variant-selector');
            const priceInput = row.querySelector('.price-input');

            const basePrice = parseFloat(prodSelect.options[prodSelect.selectedIndex]?.dataset.price || 0);
            const extraPrice = parseFloat(varSelect.options[varSelect.selectedIndex]?.dataset.extra || 0);

            priceInput.value = (basePrice + extraPrice).toFixed(2);
            recalculateEstimate();
        }

        function recalculateEstimate() {
            const planSelect = document.getElementById('planSelect');
            const selectedOpt = planSelect.options[planSelect.selectedIndex];
            const minQty = parseInt(selectedOpt?.dataset.minqty || "1");

            let totalQty = 0;
            let subtotal = 0;

            const rows = document.querySelectorAll('#linesContainer .line-row');
            rows.forEach(r => {
                const qtyInput = r.querySelector('input[name="quantities"]');
                const priceInput = r.querySelector('.price-input');
                
                const qty = parseInt(qtyInput?.value || "0");
                const price = parseFloat(priceInput?.value || "0");

                totalQty += isNaN(qty) ? 0 : qty;
                subtotal += (isNaN(qty) ? 0 : qty) * (isNaN(price) ? 0 : price);
            });

            const tax = subtotal * 0.18;
            const total = subtotal + tax;

            document.getElementById('liveSubtotal').innerText = "$" + subtotal.toFixed(2);
            document.getElementById('liveTax').innerText = "$" + tax.toFixed(2);
            document.getElementById('liveTotal').innerText = "$" + total.toFixed(2);
            document.getElementById('seatCountBadge').innerText = "Total Seats: " + totalQty;

            const statusBadge = document.getElementById('minQtyStatusBadge');
            const warnBox = document.getElementById('minQtyWarning');
            const warnText = document.getElementById('minQtyWarningText');
            const successBox = document.getElementById('minQtySuccess');
            const btnConfirm = document.getElementById('btnConfirm');

            if (totalQty < minQty) {
                const diff = minQty - totalQty;
                statusBadge.className = 'badge bg-danger-subtle text-danger px-3 py-1 rounded-pill';
                statusBadge.innerHTML = `<i class="bi bi-exclamation-circle-fill me-1"></i> Min: ${minQty} seats (Need +${diff})`;
                warnBox.classList.remove('d-none');
                warnText.innerText = `Selected plan requires minimum ${minQty} seats. Current total: ${totalQty}. Add at least ${diff} more seat(s) to confirm.`;
                successBox.classList.add('d-none');
                btnConfirm.classList.add('opacity-75');
            } else {
                statusBadge.className = 'badge bg-success-subtle text-success px-3 py-1 rounded-pill';
                statusBadge.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i> Min ${minQty} seats satisfied`;
                warnBox.classList.add('d-none');
                successBox.classList.remove('d-none');
                btnConfirm.classList.remove('opacity-75');
            }
        }

        // Attach listeners on page load
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('linesContainer').addEventListener('input', recalculateEstimate);
            recalculateEstimate();
        });
    </script>
}
