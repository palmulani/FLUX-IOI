@model List<Brightloop.Models.Plan>
@{
    ViewData["Title"] = "Subscription Plans & Governance";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Subscription Plans &amp; Governance</h4>
        <p class="text-muted small mb-0">Define billing intervals, minimum quantities, lifecycle rules, and renewal controls</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <button class="btn btn-primary-bright" data-bs-toggle="modal" data-bs-target="#newPlanModal">
            <i class="bi bi-plus-circle me-1"></i> Configure New Plan
        </button>
    }
</div>

<div class="row g-4">
    @foreach (var plan in Model)
    {
        <div class="col-lg-6">
            <div class="card-bright p-4 h-100 @(plan.IsActive ? "" : "opacity-75")">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill small mb-1">
                            Bills @plan.BillingFrequency
                        </span>
                        <h5 class="fw-bold mb-0">@plan.Name</h5>
                        <div class="small text-muted">Code: <code>@plan.Code</code></div>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold fs-4 text-dark">$@plan.BasePrice.ToString("F2")</div>
                        <div class="small text-muted">Min Qty: @plan.MinQuantity seats</div>
                    </div>
                </div>

                <div class="row g-2 p-3 bg-light rounded-3 mb-3 small">
                    <div class="col-6">
                        <span class="text-muted">Start Date:</span>
                        <div class="fw-semibold">@plan.StartDate.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">End Date:</span>
                        <div class="fw-semibold">@(plan.EndDate.HasValue ? plan.EndDate.Value.ToString("MMM dd, yyyy") : "Ongoing (No expiry)")</div>
                    </div>
                </div>

                <!-- Plan Policy Flags Matrix -->
                <h6 class="small fw-bold text-uppercase text-muted mb-2">Plan Lifecycle Rules</h6>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge @(plan.AutoCloseOnEnd ? "bg-info-subtle text-info" : "bg-light text-muted border") px-3 py-2 rounded-pill">
                        <i class="bi @(plan.AutoCloseOnEnd ? "bi-check-circle-fill text-info" : "bi-x-circle text-muted") me-1"></i> Auto-Close on End
                    </span>
                    <span class="badge @(plan.AllowEarlyClose ? "bg-success-subtle text-success" : "bg-light text-muted border") px-3 py-2 rounded-pill">
                        <i class="bi @(plan.AllowEarlyClose ? "bi-check-circle-fill text-success" : "bi-x-circle text-muted") me-1"></i> Allow Early Close
                    </span>
                    <span class="badge @(plan.AllowPause ? "bg-success-subtle text-success" : "bg-light text-muted border") px-3 py-2 rounded-pill">
                        <i class="bi @(plan.AllowPause ? "bi-check-circle-fill text-success" : "bi-x-circle text-muted") me-1"></i> Allow Pause
                    </span>
                    <span class="badge @(plan.AllowRenew ? "bg-success-subtle text-success" : "bg-light text-muted border") px-3 py-2 rounded-pill">
                        <i class="bi @(plan.AllowRenew ? "bi-check-circle-fill text-success" : "bi-x-circle text-muted") me-1"></i> Allow Renew
                    </span>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <div class="pt-2 border-top d-flex justify-content-end">
                        <form asp-action="ToggleStatus" asp-route-id="@plan.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm @(plan.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-pill px-3">
                                @(plan.IsActive ? "Disable Plan" : "Enable Plan")
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Configure New Plan Modal -->
<div class="modal fade" id="newPlanModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Configure Subscription Plan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Plan Name</label>
                            <input type="text" name="Name" class="form-control" placeholder="e.g. Starter Daily Tier" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Plan Code (Unique)</label>
                            <input type="text" name="Code" class="form-control" placeholder="e.g. PLAN-DAILY-01" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-muted">Billing Frequency</label>
                            <select name="BillingFrequency" class="form-select">
                                <option value="Daily">Daily</option>
                                <option value="Weekly">Weekly</option>
                                <option value="Monthly" selected>Monthly</option>
                                <option value="Yearly">Yearly</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-muted">Base Price ($)</label>
                            <input type="number" step="0.01" name="BasePrice" class="form-control" placeholder="950.00" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-muted">Min Quantity / Seats</label>
                            <input type="number" name="MinQuantity" value="1" min="1" class="form-control" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Available From (Start Date)</label>
                            <input type="date" name="StartDate" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Available To (End Date - Optional)</label>
                            <input type="date" name="EndDate" class="form-control" />
                        </div>
                    </div>

                    <h6 class="small fw-bold text-uppercase text-muted mb-2">Plan Policy Governance Rules</h6>
                    <div class="row g-3 p-3 bg-light rounded-3">
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="AutoCloseOnEnd" value="true" id="ruleAutoClose">
                                <label class="form-check-label small fw-semibold" for="ruleAutoClose">
                                    Auto-Close on End Date
                                </label>
                                <div class="form-text small">Closes automatically when period ends.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="AllowEarlyClose" value="true" id="ruleEarlyClose" checked>
                                <label class="form-check-label small fw-semibold" for="ruleEarlyClose">
                                    Allow Early Termination
                                </label>
                                <div class="form-text small">Customer or team can cancel early.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="AllowPause" value="true" id="rulePause" checked>
                                <label class="form-check-label small fw-semibold" for="rulePause">
                                    Allow Subscription Pausing
                                </label>
                                <div class="form-text small">Permits pausing without cancellation.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="AllowRenew" value="true" id="ruleRenew" checked>
                                <label class="form-check-label small fw-semibold" for="ruleRenew">
                                    Allow Self-Renewal
                                </label>
                                <div class="form-text small">Permits renewal extensions.</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-bright rounded-pill px-4">Create Plan</button>
                </div>
            </form>
        </div>
    </div>
</div>
