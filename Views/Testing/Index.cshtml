@{
    ViewData["Title"] = "Automated Loop Test Suite";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-shield-check text-success me-2"></i> Quality Assurance &amp; Loop Test Suite</h4>
        <p class="text-muted small mb-0">End-to-end automated verification covering all 12 operational scenarios from the Brightloop problem statement</p>
    </div>
    <button class="btn btn-primary-bright px-4" id="btnRunTests" onclick="runSuite()">
        <i class="bi bi-play-circle-fill me-1"></i> Run Complete Loop Test Suite
    </button>
</div>

<!-- Test Suite Summary Box -->
<div class="card-bright p-4 mb-4" id="summaryCard">
    <div class="row g-3 text-center">
        <div class="col-md-3">
            <div class="small text-muted text-uppercase fw-bold">Total Scenarios</div>
            <h3 class="fw-bold text-dark mt-1" id="valTotal">15</h3>
        </div>
        <div class="col-md-3">
            <div class="small text-muted text-uppercase fw-bold">Passed Scenarios</div>
            <h3 class="fw-bold text-success mt-1" id="valPassed">-</h3>
        </div>
        <div class="col-md-3">
            <div class="small text-muted text-uppercase fw-bold">Failed Scenarios</div>
            <h3 class="fw-bold text-danger mt-1" id="valFailed">-</h3>
        </div>
        <div class="col-md-3">
            <div class="small text-muted text-uppercase fw-bold">Execution Time</div>
            <h3 class="fw-bold text-primary mt-1" id="valDuration">-</h3>
        </div>
    </div>
</div>

<!-- Test Details Table -->
<div class="card-bright p-4">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr class="text-muted small text-uppercase">
                    <th style="width: 5%;">Status</th>
                    <th style="width: 28%;">Test Scenario</th>
                    <th style="width: 35%;">Requirement Description</th>
                    <th style="width: 24%;">Execution Results &amp; Details</th>
                    <th style="width: 8%;" class="text-end">Latency</th>
                </tr>
            </thead>
            <tbody id="testTableBody">
                <tr id="initialRow">
                    <td colspan="5" class="text-center py-5 text-muted">
                        <i class="bi bi-cpu fs-1 d-block mb-2 text-secondary"></i>
                        Click <strong>"Run Complete Loop Test Suite"</strong> above to execute all 12 automated verification scenarios.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function runSuite() {
            const btn = document.getElementById('btnRunTests');
            const tbody = document.getElementById('testTableBody');

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Running Test Suite...';

            tbody.innerHTML = `
                <tr>
                    <td colspan="5" class="text-center py-5">
                        <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;"></div>
                        <div class="fw-bold">Executing Loop Testing Pipeline...</div>
                        <div class="small text-muted">Verifying regex password rules, product variants (+560), anti-duplicate billing day, discounts, tax calculations, and SMTP...</div>
                    </td>
                </tr>`;

            fetch('@Url.Action("RunFullSuite", "Testing")', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(r => r.json())
            .then(data => {
                document.getElementById('valPassed').innerText = data.passed;
                document.getElementById('valFailed').innerText = data.failed;
                document.getElementById('valDuration').innerText = data.totalDurationMs + ' ms';

                let html = '';
                data.tests.forEach(t => {
                    const icon = t.passed
                        ? '<i class="bi bi-check-circle-fill text-success fs-5"></i>'
                        : '<i class="bi bi-x-circle-fill text-danger fs-5"></i>';
                    const badge = t.passed
                        ? '<span class="badge bg-success-subtle text-success px-2 py-1">PASS</span>'
                        : '<span class="badge bg-danger-subtle text-danger px-2 py-1">FAIL</span>';

                    html += `
                        <tr>
                            <td>${icon}</td>
                            <td class="fw-bold">${t.testName}</td>
                            <td class="small text-muted">${t.description}</td>
                            <td class="small">${t.details}</td>
                            <td class="text-end fw-semibold small">${t.durationMs} ms</td>
                        </tr>`;
                });

                tbody.innerHTML = html;
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> Re-Run Test Suite';
            })
            .catch(err => {
                tbody.innerHTML = `<tr><td colspan="5" class="text-danger text-center py-4">Error running test suite: ${err}</td></tr>`;
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-play-circle-fill me-1"></i> Run Complete Loop Test Suite';
            });
        }
    </script>
}
