@{
    ViewData["Title"] = "Executive Finance Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">Executive Finance &amp; Billing Command</h4>
        <p class="text-muted small mb-0">Real-time metrics for recurring revenue, overdue invoices &amp; subscription health</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold">
            <i class="bi bi-speedometer2 me-1"></i> Response: @ViewBag.ResponseTimeMs ms (SLA &lt; 2000 ms)
        </span>
        <button class="btn btn-outline-primary rounded-pill px-3 py-2 btn-sm fw-semibold" onclick="fetchAiInsight()">
            <i class="bi bi-stars text-warning me-1"></i> AI Financial Insight
        </button>
    </div>
</div>

<!-- AI Quick Insight Banner -->
<div id="aiInsightBox" class="alert alert-light border rounded-4 p-3 mb-4 shadow-sm d-none">
    <div class="d-flex align-items-start gap-3">
        <div class="p-2 bg-primary-subtle text-primary rounded-3">
            <i class="bi bi-robot fs-4"></i>
        </div>
        <div class="flex-grow-1">
            <div class="fw-bold text-dark small text-uppercase">Brightloop AI Copilot Analysis</div>
            <div id="aiInsightText" class="text-muted small mt-1">Generating financial analysis...</div>
        </div>
        <button type="button" class="btn-close" onclick="document.getElementById('aiInsightBox').classList.add('d-none')"></button>
    </div>
</div>

<!-- 5 Core KPI Metric Cards -->
<div class="row g-3 mb-4">
    <!-- Active Subscriptions -->
    <div class="col-xl-3 col-md-6">
        <div class="card-bright p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Active Subscriptions</span>
                <span class="p-2 bg-success-subtle text-success rounded-3"><i class="bi bi-arrow-repeat fs-5"></i></span>
            </div>
            <h3 class="fw-bold mb-1">@ViewBag.ActiveSubsCount</h3>
            <div class="small text-muted">of @ViewBag.TotalSubsCount total subscriptions</div>
        </div>
    </div>

    <!-- MRR & ARR -->
    <div class="col-xl-3 col-md-6">
        <div class="card-bright p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Recurring Revenue (MRR)</span>
                <span class="p-2 bg-primary-subtle text-primary rounded-3"><i class="bi bi-graph-up-arrow fs-5"></i></span>
            </div>
            <h3 class="fw-bold mb-1 text-primary">$@(((decimal)ViewBag.MRR).ToString("N2"))</h3>
            <div class="small text-muted">ARR: <strong class="text-dark">$@(((decimal)ViewBag.ARR).ToString("N0"))</strong></div>
        </div>
    </div>

    <!-- Total Revenue Collected -->
    <div class="col-xl-3 col-md-6">
        <div class="card-bright p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Total Cash Collected</span>
                <span class="p-2 bg-info-subtle text-info rounded-3"><i class="bi bi-cash-stack fs-5"></i></span>
            </div>
            <h3 class="fw-bold mb-1 text-dark">$@(((decimal)ViewBag.TotalRevenueCollected).ToString("N2"))</h3>
            <div class="small text-muted">Settled through payments</div>
        </div>
    </div>

    <!-- Outstanding & Overdue Debt -->
    <div class="col-xl-3 col-md-6">
        <div class="card-bright p-4 h-100 border-danger-subtle">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Overdue Invoices</span>
                <span class="p-2 bg-danger-subtle text-danger rounded-3"><i class="bi bi-exclamation-triangle-fill fs-5"></i></span>
            </div>
            <h3 class="fw-bold mb-1 text-danger">$@(((decimal)ViewBag.OverdueAmount).ToString("N2"))</h3>
            <div class="small text-danger fw-semibold">@ViewBag.OverdueCount overdue invoice(s) need chasing</div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card-bright p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0">Recurring Revenue &amp; Collections Run Rate</h6>
                <span class="badge bg-light text-muted border">FY 2026</span>
            </div>
            <div style="height: 280px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-bright p-4 h-100">
            <h6 class="fw-bold mb-3">Subscriptions Portfolio Health</h6>
            <div style="height: 230px; position: relative;">
                <canvas id="statusChart"></canvas>
            </div>
            <div class="mt-3 text-center small text-muted">
                <span class="me-3"><i class="bi bi-circle-fill text-success"></i> Active (@ViewBag.ActiveSubsCount)</span>
                <span><i class="bi bi-circle-fill text-warning"></i> Due for Billing (@ViewBag.DueForBillingCount)</span>
            </div>
        </div>
    </div>
</div>

<!-- Overdue Invoices Watchlist -->
<div class="card-bright p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h6 class="fw-bold mb-1 text-danger"><i class="bi bi-bell-fill me-1"></i> Overdue Invoices Requiring Chase</h6>
            <p class="text-muted small mb-0">Direct actions to chase outstanding revenue before it turns into lost revenue</p>
        </div>
        <a href="@Url.Action("Index", "Invoices", new { filter = "overdue" })" class="btn btn-sm btn-outline-danger rounded-pill px-3">
            View All Overdue (@ViewBag.OverdueCount)
        </a>
    </div>

    @if (((List<Brightloop.Models.Invoice>)ViewBag.OverdueInvoices).Count == 0)
    {
        <div class="p-4 text-center text-muted small bg-light rounded-4">
            <i class="bi bi-check2-circle text-success fs-3 d-block mb-1"></i>
            No overdue invoices! All customer accounts are settled and in good standing.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-muted small text-uppercase">
                        <th>Invoice</th>
                        <th>Customer</th>
                        <th>Due Date</th>
                        <th>Total</th>
                        <th>Balance Owed</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in (List<Brightloop.Models.Invoice>)ViewBag.OverdueInvoices)
                    {
                        <tr>
                            <td>
                                <a href="@Url.Action("Details", "Invoices", new { id = inv.Id })" class="fw-bold text-decoration-none" style="color: #4f46e5;">
                                    @inv.InvoiceNumber
                                </a>
                            </td>
                            <td>
                                <div class="fw-semibold">@inv.Customer?.FullName</div>
                                <div class="small text-muted">@inv.Customer?.CompanyName</div>
                            </td>
                            <td class="text-danger fw-semibold">
                                <i class="bi bi-calendar-x me-1"></i> @inv.DueDate.ToString("MMM dd, yyyy")
                            </td>
                            <td>$@inv.TotalAmount.ToString("F2")</td>
                            <td class="fw-bold text-danger">$@((inv.TotalAmount - inv.PaidAmount).ToString("F2"))</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <form asp-controller="Invoices" asp-action="SendEmail" asp-route-id="@inv.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3 py-1">
                                            <i class="bi bi-envelope-exclamation me-1"></i> Send Chase Email
                                        </button>
                                    </form>
                                    <a href="@Url.Action("Details", "Invoices", new { id = inv.Id })" class="btn btn-sm btn-light border rounded-pill px-3 py-1">
                                        Record Payment
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Revenue Chart
        const ctxRev = document.getElementById('revenueChart').getContext('2d');
        new Chart(ctxRev, {
            type: 'line',
            data: {
                labels: ['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct'],
                datasets: [
                    {
                        label: 'MRR ($)',
                        data: [1200, 1600, 2100, 2800, 3100, @ViewBag.MRR],
                        borderColor: '#4f46e5',
                        backgroundColor: 'rgba(79, 70, 229, 0.08)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3
                    },
                    {
                        label: 'Cash Collections ($)',
                        data: [1100, 1550, 1950, 2600, 2900, @ViewBag.TotalRevenueCollected],
                        borderColor: '#0ea5e9',
                        borderDash: [5, 5],
                        tension: 0.3,
                        borderWidth: 2
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'top' } }
            }
        });

        // Status Chart
        const ctxStatus = document.getElementById('statusChart').getContext('2d');
        new Chart(ctxStatus, {
            type: 'doughnut',
            data: {
                labels: ['Active', 'Due for Billing', 'Other'],
                datasets: [{
                    data: [@ViewBag.ActiveSubsCount, @ViewBag.DueForBillingCount, 1],
                    backgroundColor: ['#22c55e', '#f59e0b', '#cbd5e1']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '72%',
                plugins: { legend: { display: false } }
            }
        });

        function fetchAiInsight() {
            const box = document.getElementById('aiInsightBox');
            const text = document.getElementById('aiInsightText');
            box.classList.remove('d-none');
            text.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Analyzing database revenue records with OpenRouter AI...';

            fetch('@Url.Action("GetAiInsight", "Dashboard")')
                .then(r => r.json())
                .then(data => {
                    text.innerHTML = data.insight.replace(/\n/g, '<br>');
                })
                .catch(err => {
                    text.innerText = 'Unable to reach AI endpoint. Financial records healthy.';
                });
        }
    </script>
}
